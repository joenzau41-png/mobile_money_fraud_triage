{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Mobile Money Fraud Triage: Exploratory Data Analysis\n",
    "\n",
    "This notebook profiles the synthetic PaySim mobile-money dataset used for fraud detection. It checks the schema, class balance, missing data, and transaction patterns before any model training.\n",
    "\n",
    "The project expects the processed sample parquet at `data/processed/paysim_sample.parquet` or the raw CSV at `data/raw/...`. If neither exists, the notebook prints a clear instruction to download/convert the data.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import sys\n",
    "\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "ROOT = Path.cwd().resolve().parent if Path.cwd().name == 'notebooks' else Path.cwd().resolve()\n",
    "if str(ROOT / 'src') not in sys.path:\n",
    "    sys.path.insert(0, str(ROOT))\n",
    "\n",
    "print(f'Project root: {ROOT}')\n",
    "print(f'Notebook working directory: {Path.cwd()}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.data import SAMPLE_PARQUET, RAW_CSV, load\n",
    "\n",
    "sample_path = SAMPLE_PARQUET\n",
    "raw_path = RAW_CSV\n",
    "\n",
    "if sample_path.exists():\n",
    "    df = load(sample=True)\n",
    "elif raw_path.exists():\n",
    "    df = pd.read_csv(raw_path)\n",
    "else:\n",
    "    print('No processed or raw data found.')\n",
    "    print('Run: python -m src.data convert')\n",
    "    print('or download the Kaggle dataset first.')\n",
    "    df = None\n",
    "\n",
    "if df is not None:\n",
    "    print(f'Loaded shape: {df.shape}')\n",
    "    display(df.head())\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1) Dataset profile\n",
    "\n",
    "Review the rows, columns, data types, and target label distribution.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if df is not None:\n",
    "    print('Columns:', list(df.columns))\n",
    "    print('Dtypes:\n', df.dtypes)\n",
    "    print(f'Unique rows: {df.duplicated().sum()} duplicates')\n",
    "    print(f'Missing values per column:\\n{df.isna().sum().sort_values(ascending=False).head(10)}')\n",
    "\n",
    "    if 'isFraud' in df.columns:\n",
    "        fraud_rate = df['isFraud'].mean()\n",
    "        print(f'Fraud rate: {fraud_rate:.4%}')\n",
    "        display(df['isFraud'].value_counts(normalize=True).rename('share').to_frame())\n",
    "    else:\n",
    "        print('Target column `isFraud` not found; verify source schema before training.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2) Transaction-type behaviour\n",
    "\n",
    "Explore how transaction type and fraud incidence vary across the dataset.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if df is not None and 'type' in df.columns and 'isFraud' in df.columns:\n",
    "    type_summary = df.groupby('type').agg(\n",
    "        transactions=('type', 'size'),\n",
    "        fraud_cases=('isFraud', 'sum'),\n",
    "        fraud_rate=('isFraud', 'mean')\n",
    "    ).sort_values(['transactions', 'fraud_cases'], ascending=False)\n",
    "    display(type_summary)\n",
    "\n",
    "    plt.figure(figsize=(10, 5))\n",
    "    sns.barplot(data=type_summary.reset_index(), x='type', y='fraud_rate', palette='viridis')\n",
    "    plt.title('Fraud rate by transaction type')\n",
    "    plt.ylabel('Fraud rate')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "else:\n",
    "    print('Transaction type columns not present; dataset schema may differ from the expected PaySim layout.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3) Numeric feature patterns\n",
    "\n",
    "Look for obvious skew, outliers, and class separation in the key monetary and balance-related features.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if df is not None:\n",
    "    numeric_cols = df.select_dtypes(include='number').columns.tolist()\n",
    "    feature_candidates = [\n",
    "        c for c in ['amount', 'oldbalanceOrg', 'newbalanceOrig', 'oldbalanceDest', 'newbalanceDest']\n",
    "        if c in numeric_cols\n",
    "    ]\n",
    "    print('Candidate features:', feature_candidates)\n",
    "\n",
    "    if feature_candidates:\n",
    "        fig, axes = plt.subplots(len(feature_candidates), 2, figsize=(14, 4 * len(feature_candidates)))\n",
    "        for idx, col in enumerate(feature_candidates):\n",
    "            if 'isFraud' in df.columns:\n",
    "                sns.histplot(data=df, x=col, hue='isFraud', bins=40, alpha=0.6, log_scale=True, ax=axes[idx, 0])\n",
    "                axes[idx, 0].set_title(f'{col} distribution by fraud label')\n",
    "                sns.boxplot(data=df, x='isFraud', y=col, ax=axes[idx, 1])\n",
    "                axes[idx, 1].set_title(f'{col} by fraud label')\n",
    "            else:\n",
    "                sns.histplot(data=df, x=col, bins=40, log_scale=True, ax=axes[idx, 0])\n",
    "                axes[idx, 0].set_title(f'{col} distribution')\n",
    "                axes[idx, 1].axis('off')\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "    else:\n",
    "        print('No standard monetary columns were found in this dataset snapshot.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4) Time-based review and next steps\n",
    "\n",
    "Check the timeline and summarise likely modelling considerations for train/validation splitting.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if df is not None:\n",
    "    if 'step' in df.columns:\n",
    "        print(f'Min step: {df[\'step\'].min()}')\n",
    "        print(f'Max step: {df[\'step\'].max()}')\n",
    "        print(f'Estimated time horizon: {df[\'step\'].max() - df[\'step\'].min() + 1} steps')\n",
    "        if 'isFraud' in df.columns:\n",
    "            by_step = df.groupby('step')['isFraud'].mean().to_frame('fraud_rate')\n",
    "            display(by_step.head())\n",
    "    else:\n",
    "        print('The expected `step` timestamp column is missing.')\n",
    "    print('')\n",
    "    print('Suggested next steps:')\n",
    "    print('- decide a time-based train/validation split')\n",
    "    print('- encode categorical fields and engineer aggregate customer behaviour features')\n",
    "    print('- evaluate class imbalance with precision/recall/F1 and PR curves')\n"
   ]
  }
 ],
